# ─── Base de données (Neon.tech — gratuit) ────────────────────────────────────
# https://neon.tech → New project → copier la connection string
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/pokemarket?sslmode=require

# ─── Cache Redis (Upstash — gratuit) ─────────────────────────────────────────
# https://console.upstash.com → Create database → REST API
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# ─── Auth (Clerk — gratuit jusqu'à 10k utilisateurs) ─────────────────────────
# https://dashboard.clerk.com → Create application
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ─── Paiements (Stripe — gratuit à l'intégration) ────────────────────────────
# https://dashboard.stripe.com
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Pokémon TCG API (gratuit) ────────────────────────────────────────────────
# https://pokemontcg.io/develop — clé optionnelle, augmente le rate limit
POKEMON_TCG_API_KEY=

# ─── IA de scan (Anthropic Claude Vision) ────────────────────────────────────
# https://console.anthropic.com → API Keys → Create key
ANTHROPIC_API_KEY=sk-ant-...

# ─── URL publique (auto sur Vercel, mettre manuellement en dev) ───────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
