{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/update-prices",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/update-prices-fr",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/investment-picks",
      "schedule": "0 8 1 * *"
    }
  ]
}
